#!/bin/sh
# Starts Remnawave Node without Docker/s6: prepares the runtime environment
# that docker/rootfs/etc/s6-overlay/scripts/init-env.sh provides in the image,
# then execs node. Xray is supervised by node itself (XRAY_PROCESS_MANAGER=native).
set -eu

APP_DIR="${REMNANODE_HOME:-/opt/remnanode}"
CONF_FILE="${REMNANODE_CONFIG:-/etc/remnanode/remnanode.env}"
REMNANODE_RUN_DIR="${REMNANODE_RUN_DIR:-/run/remnanode}"
RUNTIME_NODE=/usr/local/lib/remnanode/node/bin/node

if [ -f "$CONF_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONF_FILE"
    set +a
fi

# Official Node.js build installed by rwnode (non-Alpine), else the system one.
if [ -z "${NODE_BIN:-}" ]; then
    if [ -x "$RUNTIME_NODE" ]; then NODE_BIN=$RUNTIME_NODE; else NODE_BIN=node; fi
fi

# systemd ignores SIGPIPE, so tr reports the closed pipe instead of exiting quietly.
gen() {
    tr -dc 'a-zA-Z0-9' < /dev/urandom 2>/dev/null | head -c "${1:-64}"
}

RNDSTR=$(gen 10)
INTERNAL_REST_TOKEN=$(gen 64)
INTERNAL_SOCKET_PATH="rwint-${RNDSTR}"
XTLS_API_SOCKET_PATH="xtls-api-${RNDSTR}"

# Lets remnanode-cli reach the internal API of the running instance.
mkdir -p "$REMNANODE_RUN_DIR"
chmod 700 "$REMNANODE_RUN_DIR"
(
    umask 077
    printf 'INTERNAL_SOCKET_PATH=%s\nINTERNAL_REST_TOKEN=%s\n' \
        "$INTERNAL_SOCKET_PATH" "$INTERNAL_REST_TOKEN" > "$REMNANODE_RUN_DIR/internal.env"
)

# Memory (Debian 13 x64, RssAnon, bundled build): with V8 defaults idle 54 MB and
# 63 MB with 20k users, with these settings 39 and 46 MB, at the same speed.
#   - a small young generation instead of V8's default (up to 3 x 16 MB)
#   - --optimize-for-size: V8 trades a little speed for memory
#   - fewer glibc malloc arenas (MALLOC_ARENA_MAX below)
# Set NODE_SEMI_SPACE_MB= or NODE_V8_FLAGS= (empty) in the config to turn them off;
# the JS heap is only capped when NODE_MAX_HEAP_MB is set.
NODE_MEMORY_OPTIONS=""
_semi="${NODE_SEMI_SPACE_MB-2}"
if [ -n "$_semi" ]; then NODE_MEMORY_OPTIONS="--max-semi-space-size=$_semi"; fi
if [ "${NODE_V8_FLAGS+set}" = set ]; then _v8=$NODE_V8_FLAGS; else _v8=--optimize-for-size; fi
NODE_MEMORY_OPTIONS="$NODE_MEMORY_OPTIONS $_v8"
if [ -n "${NODE_MAX_HEAP_MB:-}" ]; then
    NODE_MEMORY_OPTIONS="$NODE_MEMORY_OPTIONS --max-old-space-size=$NODE_MAX_HEAP_MB"
fi
NODE_MEMORY_OPTIONS="$NODE_MEMORY_OPTIONS ${NODE_ARGS:-}"

export INTERNAL_REST_TOKEN INTERNAL_SOCKET_PATH XTLS_API_SOCKET_PATH REMNANODE_RUN_DIR
export XRAY_PROCESS_MANAGER=native
export NODE_ENV="${NODE_ENV:-production}"
export XRAY_JSON_STRICT="${XRAY_JSON_STRICT:-true}"
export UV_THREADPOOL_SIZE="${UV_THREADPOOL_SIZE:-24}"
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
export NODE_OPTIONS="--max-http-header-size=65536${NODE_OPTIONS:+ $NODE_OPTIONS}"

# Unprivileged LXC may cap the hard limit below the value used in docker-compose.
# shellcheck disable=SC3045 # busybox ash and dash support ulimit -n/-H
ulimit -n 1048576 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null || true

mkdir -p /var/log/xray

cd "$APP_DIR"
# Not in NODE_OPTIONS: V8 rejects some of these flags there.
# shellcheck disable=SC2086
exec "$NODE_BIN" $NODE_MEMORY_OPTIONS dist/main.js
