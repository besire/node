#!/bin/sh
# Runs dist/cli.js against the running node (dump config, kill sockets).
set -eu

APP_DIR="${REMNANODE_HOME:-/opt/remnanode}"
RUN_DIR="${REMNANODE_RUN_DIR:-/run/remnanode}"
RUNTIME_NODE=/usr/local/lib/remnanode/node/bin/node

if [ -f "$RUN_DIR/internal.env" ]; then
    set -a
    # shellcheck disable=SC1091
    . "$RUN_DIR/internal.env"
    set +a
fi

if [ -x "$RUNTIME_NODE" ]; then NODE_BIN=$RUNTIME_NODE; else NODE_BIN=node; fi

exec "$NODE_BIN" "$APP_DIR/dist/cli.js" "$@"
