#!/bin/sh
# Starts Remnawave Node without Docker/s6: prepares the runtime environment
# that docker/rootfs/etc/s6-overlay/scripts/init-env.sh provides in the image,
# then execs node. Xray is supervised by node itself (XRAY_PROCESS_MANAGER=native).
set -eu

APP_DIR="${REMNANODE_HOME:-/opt/remnanode}"
CONF_FILE="${REMNANODE_CONFIG:-/etc/remnanode/remnanode.env}"
REMNANODE_RUN_DIR="${REMNANODE_RUN_DIR:-/run/remnanode}"

if [ -f "$CONF_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONF_FILE"
    set +a
fi

gen() {
    tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c "${1:-64}"
}

RNDSTR=$(gen 10)
INTERNAL_REST_TOKEN=$(gen 64)
INTERNAL_SOCKET_PATH="rwint-${RNDSTR}"
XTLS_API_SOCKET_PATH="xtls-api-${RNDSTR}"

# Lets remnanode-cli reach the internal API of the running instance.
mkdir -p "$REMNANODE_RUN_DIR"
chmod 700 "$REMNANODE_RUN_DIR"
(
    umask 077
    printf 'INTERNAL_SOCKET_PATH=%s\nINTERNAL_REST_TOKEN=%s\n' \
        "$INTERNAL_SOCKET_PATH" "$INTERNAL_REST_TOKEN" > "$REMNANODE_RUN_DIR/internal.env"
)

export INTERNAL_REST_TOKEN INTERNAL_SOCKET_PATH XTLS_API_SOCKET_PATH REMNANODE_RUN_DIR
export XRAY_PROCESS_MANAGER=native
export NODE_ENV="${NODE_ENV:-production}"
export XRAY_JSON_STRICT="${XRAY_JSON_STRICT:-true}"
export UV_THREADPOOL_SIZE="${UV_THREADPOOL_SIZE:-24}"
export NODE_OPTIONS="--max-http-header-size=65536${NODE_OPTIONS:+ $NODE_OPTIONS}"

# Unprivileged LXC may cap the hard limit below the value used in docker-compose.
# shellcheck disable=SC3045 # busybox ash supports ulimit -n/-H
ulimit -n 1048576 2>/dev/null || ulimit -n "$(ulimit -Hn)" 2>/dev/null || true

mkdir -p /var/log/xray

cd "$APP_DIR"
exec node dist/main.js
